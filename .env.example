# Google Gemini (used when OPENROUTER_API_KEY is empty)
GOOGLE_API_KEY=EXAMPLE
GENERATION_MODEL_NAME=gemma-4-31b-it
EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# Supadata for transcript extraction
SUPADATA_API_KEY=EXAMPLE

# OpenRouter (set OPENROUTER_API_KEY to switch from Google Gemini to OpenRouter)
OPENROUTER_API_KEY=EXAMPLE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=xiaomi/mimo-v2.5
OPENROUTER_EMBEDDING_MODEL_NAME=openai/text-embedding-3-small